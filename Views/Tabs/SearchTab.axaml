<UserControl
    mc:Ignorable="d"
    x:Class="RainbusToolbox.Views.Tabs.SearchTab"
    x:DataType="tabs:SearchTabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabs="clr-namespace:RainbusToolbox.ViewModels.Tabs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Vertical">

        <!--  status text  -->
        <TextBlock
            Classes="header"
            FontSize="32"
            Foreground="White"
            HorizontalAlignment="Left"
            Margin="5,10"
            Text="{Binding SearchStatus}" />
        <!--
            panel for first search line, so the textbox and the "match case", "match whole word" and "regex mode" toggles
            buttons are 70x70 aligned to the right end, textbox fills everything from the left to these buttons
            TODO: I have to make custom visuals for all buttons here, as i have them textless here!!
        -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox
                BorderThickness="0"
                Classes="framed"
                FontFamily="{StaticResource PretendardFont}"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                Height="70"
                Margin="5,0"
                Text="{Binding TextToSearch}"
                TextAlignment="Left"
                ToolTip.Tip="Text you're searching for"
                VerticalAlignment="Center"
                Watermark="Search for...">
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding ProcessSearch}" Gesture="Enter" />
                </TextBox.KeyBindings>
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="LostFocus">
                        <InvokeCommandAction Command="{Binding ProcessSearch}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </TextBox>

            <!--  not bound yet  -->
            <CheckBox
                Grid.Column="1"
                Height="70"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Margin="5,0"
                ToolTip.Tip="Match case"
                Width="70" />
            <CheckBox
                Grid.Column="2"
                Height="70"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Margin="5,0"
                ToolTip.Tip="Match whole words"
                Width="70" />
            <CheckBox
                Grid.Column="3"
                Height="70"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Margin="5,0"
                ToolTip.Tip="Regex mode"
                Width="70" />

        </Grid>

        <!--  panel for the replacement thingies (placeholders for now), textbox + "preserve case" toggle and "replace all" button  -->
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10">
            <TextBox
                BorderThickness="0"
                Classes="framed"
                FontFamily="{StaticResource PretendardFont}"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                Height="70"
                IsEnabled="False"
                IsReadOnly="True"
                Margin="5,0"
                Text="{Binding ReplaceToText}"
                TextAlignment="Left"
                ToolTip.Tip="Text you want to replace what you found to"
                VerticalAlignment="Center"
                Watermark="Replace with..." />

            <CheckBox
                Grid.Column="1"
                Height="70"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Margin="5,0"
                ToolTip.Tip="Preserve case when replacing"
                Width="70" />

            <Button
                Grid.Column="2"
                Height="70"
                IsEnabled="False"
                Margin="5,0"
                ToolTip.Tip="Replace all"
                Width="70" />

        </Grid>

        <!--
            stack panel for the found content
            don't forget to add remove button to each entry to exclude them for results (so you can remove certain files from batch replacement)
            also group findings by file, so everything found in 1 file will be 1 group
        -->
        <StackPanel Orientation="Vertical" />
    </StackPanel>


</UserControl>