<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="RainbusToolbox.Views.Tabs.FilesTab"
    x:DataType="tabs:FilesTabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabs="clr-namespace:RainbusToolbox.ViewModels.Tabs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Panel>
        <!--  Main menu  -->
        <StackPanel
            IsVisible="{Binding !ShowRegexEditor}"
            Margin="20"
            Spacing="10">
            <Button
                Classes="header"
                Command="{Binding ParseFilesCommand}"
                Content="Добавить новые файлы из игры"
                Height="80"
                HorizontalAlignment="Center"
                Width="480" />
            <Button
                Classes="header"
                Command="{Binding ReplaceAllTagsWithMeshesAsync}"
                Content="Заменить все теги формата [Key:'Value'] на html/TMPro"
                Height="80"
                HorizontalAlignment="Center"
                Width="720" />
            <Button
                Classes="header"
                Command="{Binding PullNewKeywordsFromTheGame}"
                Content="Добавить новые кейворды из игры"
                Height="80"
                HorizontalAlignment="Center"
                Width="720" />
            <Button
                Classes="header"
                Command="{Binding DefineNewKeywordsFromTheGame}"
                Content="Определить цвета новых кейвордов"
                Height="80"
                HorizontalAlignment="Center"
                Width="720" />
            <Button
                Classes="header"
                Command="{Binding OverrideCurrentKeywordsWithMTL}"
                Content="Скачать кейворды от MTL (Перезаписывает то, что есть)"
                Height="80"
                HorizontalAlignment="Center"
                Width="720" />
            <Button
                Classes="header"
                Command="{Binding OpenRegexEditor}"
                Content="Редактор автозамен"
                Height="80"
                HorizontalAlignment="Center"
                Width="720" />
        </StackPanel>

        <!--  Regex editor  -->
        <DockPanel IsVisible="{Binding ShowRegexEditor}">
            <StackPanel
                DockPanel.Dock="Top"
                Margin="8,4"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{Binding CloseRegexEditorWithSaveCommand}"
                    Content="Сохранить и закрыть"
                    Height="70"
                    Padding="12,4"
                    Width="600" />
                <Button
                    Command="{Binding CloseRegexEditorCommand}"
                    Content="Закрыть (Без сохранения)"
                    Height="70"
                    Padding="12,4"
                    Width="600" />
            </StackPanel>

            <ContentControl Content="{Binding RegexEditor}" />
        </DockPanel>
    </Panel>
</UserControl>