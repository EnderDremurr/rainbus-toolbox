<UserControl
    d:DesignHeight="450"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="RainbusToolbox.Views.Tabs.FilesTab"
    x:DataType="tabs:FilesTabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabs="clr-namespace:RainbusToolbox.ViewModels.Tabs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Panel>
        <!--  Main menu  -->
        <Grid
            ColumnDefinitions="*,*,*,*"
            IsVisible="{Binding !ShowRegexEditor}"
            Margin="20">

            <StackPanel
                Grid.Column="0"
                Margin="20"
                Orientation="Vertical"
                Spacing="10">

                <TextBlock
                    Classes="header"
                    Text="Манипуляции с игрой"
                    TextAlignment="Center" />

                <Button
                    Classes="header"
                    Command="{Binding ParseFilesCommand}"
                    Content="Добавить новые файлы из игры"
                    Height="90"
                    HorizontalAlignment="Center" />
                <Button
                    Classes="header"
                    Command="{Binding PullNewKeywordsFromTheGame}"
                    Content="Добавить новые&#10;кейворды из игры"
                    Height="90"
                    HorizontalAlignment="Center" />

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="20"
                Orientation="Vertical"
                Spacing="10">

                <TextBlock
                    Classes="header"
                    Text="Манипуляции с кейвордами"
                    TextAlignment="Center" />

                <Button
                    Classes="header"
                    Command="{Binding DefineNewKeywordsFromTheGame}"
                    Content="Определить цвета&#10;новых кейвордов"
                    Height="90"
                    HorizontalAlignment="Center" />
                <Button
                    Classes="header"
                    Command="{Binding OverrideCurrentKeywordsWithMTL}"
                    Content="Скачать кейворды от MTL&#10;(Перезаписывает то, что есть)"
                    Height="90"
                    HorizontalAlignment="Center" />
                <Button
                    Classes="header"
                    Command="{Binding ReplaceAllTagsWithMeshesAsync}"
                    Content="Заменить все теги формата&#10;[Key:'Value'] на html/TMPro"
                    Height="90"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Margin="20"
                Orientation="Vertical"
                Spacing="10">

                <TextBlock
                    Classes="header"
                    Text="Другое"
                    TextAlignment="Center" />

            </StackPanel>

            <StackPanel
                Grid.Column="3"
                Margin="20"
                Orientation="Vertical"
                Spacing="10">

                <TextBlock
                    Classes="header"
                    Text="Автозамены"
                    TextAlignment="Center" />
                <Button
                    Classes="header"
                    Command="{Binding OpenRegexEditor}"
                    Content="Редактор автозамен"
                    Height="90"
                    HorizontalAlignment="Center" />

            </StackPanel>

        </Grid>

        <!--  Regex editor  -->
        <DockPanel IsVisible="{Binding ShowRegexEditor}">

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8"
                DockPanel.Dock="Top"
                Margin="8,4">

                <Button
                    Command="{Binding CloseRegexEditorWithSaveCommand}"
                    Content="Сохранить и закрыть"
                    Grid.Column="0"
                    Height="70"
                    Padding="12,4" />
                <Button
                    Command="{Binding AskRegexEditorToSaveCommand}"
                    Content="Сохранить"
                    Grid.Column="1"
                    Height="70"
                    Padding="12,4" />
                <Button
                    Command="{Binding CloseRegexEditorCommand}"
                    Content="Закрыть"
                    Grid.Column="2"
                    Height="70"
                    Padding="12,4" />
            </Grid>

            <ContentControl Content="{Binding RegexEditor}" />
        </DockPanel>
    </Panel>
</UserControl>