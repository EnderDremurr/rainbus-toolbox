<Window
    Height="720"
    SystemDecorations="None"
    Title="SettingsWindow"
    Width="1080"
    mc:Ignorable="d"
    x:Class="RainbusToolbox.Views.Misc.SettingsWindow"
    x:DataType="misc:SettingsWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:misc="clr-namespace:RainbusToolbox.ViewModels.Misc"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Closing">
            <InvokeCommandAction Command="{Binding SaveSettingsCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <Grid>
        <!--  Background  -->
        <Image
            HorizontalAlignment="Center"
            Source="/Assets/Backgrounds/SettingsBG.png"
            Stretch="UniformToFill"
            VerticalAlignment="Center" />

        <Grid RowDefinitions="60,*">
            <!--  Toolbar  -->
            <Grid
                Background="Transparent"
                Grid.Row="0"
                PointerPressed="TitleBar_OnPointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Classes="header"
                    Foreground="White"
                    Grid.Column="0"
                    Margin="15,0,0,0"
                    Text="Settings"
                    VerticalAlignment="Center" />
                <Button
                    Classes="navigation"
                    Click="CloseButton_Click"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Margin="0,5,15,0"
                    VerticalAlignment="Center"
                    x:Name="CloseButton" />
            </Grid>

            <!--  Content  -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Margin="20"
                    Spacing="15"
                    VerticalAlignment="Top">

                    <!--  GitHub button + token placeholder  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <Button
                            Command="{Binding AskSetGitHubTokenCommand}"
                            Content="Залогиниться"
                            Height="60"
                            Width="200" />
                        <TextBlock
                            Foreground="White"
                            Text="{Binding GitHubAuthState}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!--  Discord WebHook  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="WebHook:"
                            VerticalAlignment="Center"
                            Width="150" />
                        <TextBox
                            Classes="framed"
                            Height="60"
                            PasswordChar="*"
                            RevealPassword="{Binding IsWebhookVisible}"
                            Text="{Binding DiscordWebhook}"
                            Width="500" />

                        <ToggleButton Content="{Binding WebhookToggleText}" IsChecked="{Binding IsWebhookVisible}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Айди дискорд роли:"
                            VerticalAlignment="Center"
                            Width="150" />
                        <TextBox
                            Classes="framed"
                            Height="60"
                            Text="{Binding DiscordRoleToPing}"
                            Width="500" />
                    </StackPanel>

                    <!--  Path to localization's repo  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Путь к файлам перевода:"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Width="150" />
                        <TextBox
                            Classes="framed"
                            Height="60"
                            IsReadOnly="True"
                            Text="{Binding RepoPath}"
                            Width="500" />
                        <Button
                            Command="{Binding BrowseRepoFolderCommand}"
                            Content="Выбрать"
                            Height="60"
                            Width="150" />
                    </StackPanel>

                    <!--  Path to limbus company files  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Путь к файлам игры:"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Width="150" />
                        <TextBox
                            Classes="framed"
                            Height="60"
                            IsReadOnly="True"
                            Text="{Binding LimbusPath}"
                            Width="500" />
                        <Button
                            Command="{Binding BrowseLimbusFolderCommand}"
                            Content="Выбрать"
                            Height="60"
                            Width="150" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Angela token:"
                            VerticalAlignment="Center"
                            Width="150" />
                        <TextBox
                            Classes="framed"
                            Height="60"
                            PasswordChar="*"
                            Text="{Binding AngelaToken}"
                            Width="500" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Angela prompt:"
                            VerticalAlignment="Top"
                            Width="150" />
                        <TextBox
                            AcceptsReturn="True"
                            Classes="framed"
                            Height="500"
                            Text="{Binding AngelaPrompt}"
                            TextWrapping="Wrap"
                            Width="500" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Логи:"
                            VerticalAlignment="Center"
                            Width="150" />
                        <Button
                            Command="{Binding OpenFolderWithLogsCommand}"
                            Content="Открыть папку с логами"
                            Height="60"
                            Width="500" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>