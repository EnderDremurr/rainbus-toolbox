<Application
    RequestedThemeVariant="Default"
    x:Class="RainbusToolbox.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:global1="clr-namespace:"
    xmlns:local="using:RainbusToolbox"
    xmlns:translation="clr-namespace:RainbusToolbox.Views.Translation"
    xmlns:vm="clr-namespace:RainbusToolbox.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RainbusToolbox/Styles/Themes/GenericTabItemTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  Converter instance for checkbox images  -->
            <local:CheckedToImageConverter x:Key="CheckedToImageConverter" />
            <!--  Custom font registration  -->
            <FontFamily x:Key="PretendardFont">avares://RainbusToolbox/Assets/Fonts/Pretendard.ttf#Pretendard</FontFamily>
            <FontFamily x:Key="MikodacsFont">avares://RainbusToolbox/Assets/Fonts/Mikodacs.ttf#Mikodacs Regular</FontFamily>
            <global1:TextBoxTextConverter x:Key="TextBoxTextConverter" />
            <DropShadowEffect
                BlurRadius="0"
                Color="Black"
                OffsetX="1"
                OffsetY="1"
                Opacity="1"
                x:Key="HardShadow" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <StyleInclude Source="avares://RainbusToolbox/Styles/Typography.axaml" />
        <StyleInclude Source="avares://RainbusToolbox/Styles/Themes/DefaultButtonTheme.axaml" />

        <StyleInclude Source="avares://RainbusToolbox/Styles/Themes/TextBoxFramedTheme.axaml" />
        <StyleInclude Source="avares://RainbusToolbox/Styles/Themes/TextBoxInvisibleTheme.axaml" />
        <StyleInclude Source="avares://RainbusToolbox/Styles/Controls/Checkbox.axaml" />
        <StyleInclude Source="avares://RainbusToolbox/Styles/Controls/ToggleButton.axaml" />
        <StyleInclude Source="avares://RainbusToolbox/Styles/Controls/NavigationButtons.axaml" />
        <StyleInclude Source="avares://RainbusToolbox/Styles/Controls/NavigationTabs.axaml" />
        <StyleInclude Source="avares://RainbusToolbox/Styles/Themes/GenericLoadingBar.axaml" />

        <Style Selector="Border.framed">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Background" Value="Transparent" />
        </Style>


    </Application.Styles>

    <Application.DataTemplates>

        <DataTemplate DataType="{x:Type vm:AbnormalityGuideTranslationEditorViewModel}">
            <translation:AbnormalityGuideTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BattleAnnouncerTranslationEditorViewModel}">
            <translation:BattleAnnouncerTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BattleHintsEditorViewModel}">
            <translation:BattleHintsTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EGOGiftTranslationEditorViewModel}">
            <translation:EGOGiftTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EGOVoiceTranslationEditorViewModel}">
            <translation:EGOVoiceTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UnknownFileTranslationEditorViewModel}">
            <translation:UnknownFileTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KeywordTranslationEditorViewModel}">
            <translation:KeywordTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PanicTranslationEditorViewModel}">
            <translation:PanicTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PassiveTranslationEditorViewModel}">
            <translation:PassiveTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PersonalityVoiceTranslationEditorViewModel}">
            <translation:PersonalityVoiceTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SkillsEgoTranslationEditorViewModel}">
            <translation:SkillsEgoTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StoryTranslationEditorViewModel}">
            <translation:StoryTranslationEditor />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UiElementTranslationEditorViewModel}">
            <translation:UiElementTranslationEditor />
        </DataTemplate>

    </Application.DataTemplates>
</Application>